# Copy to .env.local. Both values are public (safe in the browser); data is protected by RLS, not by hiding these.
# Never put the service_role key in any NEXT_PUBLIC_ var or in this repo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# SERVER ONLY. WARNING: bypasses RLS and can delete users. Never prefix with NEXT_PUBLIC_, never commit it,
# never import it in client code. Set it in .env.local and in Vercel (server env, not exposed to the browser).
# Leave empty and /api/delete-account refuses to run (fails closed).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Cloudflare Turnstile SITE key (public). Unset = no CAPTCHA, sign-in works as before.
# The matching SECRET goes only in Supabase Dashboard > Auth > Bot and Abuse Protection, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supporter tier (Razorpay). SERVER ONLY, never NEXT_PUBLIC_. Leave empty = subscribe/webhook routes return 503.
# Key ID + secret: Razorpay Dashboard > API Keys. Webhook secret: Dashboard > Webhooks (set the same value there).
# Plan ID: the Razorpay monthly plan (plan_...). Webhook also needs SUPABASE_SERVICE_ROLE_KEY above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
